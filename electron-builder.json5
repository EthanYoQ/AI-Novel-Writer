// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.ai-novel-writer.app",
  "asar": true,
  "asarUnpack": [
    "node_modules/apache-arrow/**/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/@lancedb/lancedb/**/*",
    "node_modules/@lancedb/lancedb-darwin-*/**/*",
    "node_modules/@lancedb/lancedb-linux-*/**/*",
    "node_modules/@lancedb/lancedb-win32-*/**/*",
    "node_modules/@lancedb/lancedb-win32-x64-msvc/**/*"
  ],
  // exe、.app、卸载程序与任务管理器里显示的名字。安装目录、注册表键、设置目录与更新缓存都不随它变（ADR-0022）。
  "productName": "书童",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "build"
  ],
  "mac": {
    "target": ["dmg"],
    "artifactName": "ai-novel-writer-mac-${arch}-${version}-installer.${ext}",
    "category": "public.app-category.productivity",
    "identity": "-",
    "hardenedRuntime": false,
    "extraResources": [
      {
        "from": "electron/security/darwin-safe-file-system",
        "to": "security/darwin-safe-file-system"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "EthanYoQ",
        "repo": "AI-Novel-Writer",
        "channel": "latest",
        "releaseType": "release",
        "publishAutoUpdate": true,
        "tagNamePrefix": "v"
      }
    ],
    "extraResources": [
      {
        "from": "electron/security/windows-safe-file-system.ps1",
        "to": "security/windows-safe-file-system.ps1"
      }
    ]
  },
  "nsis": {
    "artifactName": "ai-novel-writer-setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    // 快捷方式与「应用和功能」里显示中英双名。从 AI小说作家.exe 升级时旧卸载程序按注册表里的旧 ShortcutName 删掉旧快捷方式，
    // 新安装程序再建新的，不会多出一份。
    "shortcutName": "书童 Pagekin",
    "uninstallDisplayName": "书童 Pagekin ${version}",
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "category": "Office"
  }
}
